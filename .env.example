# Copy this file to .env and replace every "replace-with" value before starting.
ENVIRONMENT=development
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
# Encrypts the provider keys each workspace stores (BYOK). Back it up: losing it makes stored keys unreadable.
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# Accounts with these emails get the platform admin console (comma-separated).
ADMIN_EMAILS=

# Optional platform model. Workspaces normally connect their own providers from the Models tab.
LITELLM_MODEL=gpt-4o-mini
ALLOWED_MODELS=
OPENAI_API_KEY=
OLLAMA_API_BASE=http://host.docker.internal:11434
# Allow http and private-network endpoints (vLLM, LM Studio, Ollama) for self-hosted models.
ALLOW_PRIVATE_MODEL_ENDPOINTS=true
DAILY_TOKEN_BUDGET_PER_USER=200000

# Public URLs used for OAuth redirects and links in emails.
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Optional: sign in with Google or GitHub, Google Drive, SharePoint and OneDrive. Empty values hide the feature.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional: SMTP for invitations and password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: shared secret for the scheduler endpoint that runs due automations.
AUTOMATION_TOKEN=

# true only when DATABASE_URL points at a transaction-mode pooler (Supabase port 6543)
DB_TRANSACTION_POOLER=false
