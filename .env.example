# Copy this file to .env and replace both secrets before starting.
ENVIRONMENT=development
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
LITELLM_MODEL=gpt-4o-mini
# Comma-separated list of models users may select (defaults to LITELLM_MODEL).
ALLOWED_MODELS=
OPENAI_API_KEY=
OLLAMA_API_BASE=http://host.docker.internal:11434
DAILY_TOKEN_BUDGET_PER_USER=200000
# true only when DATABASE_URL points at a transaction-mode pooler (Supabase port 6543)
DB_TRANSACTION_POOLER=false
